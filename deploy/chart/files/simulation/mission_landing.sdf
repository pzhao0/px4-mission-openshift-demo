<?xml version="1.0"?>
<sdf version="1.9">
  <world name="mission_landing">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <scene>
      <ambient>0.7 0.7 0.7 1</ambient>
      <background>0.55 0.75 0.95 1</background>
      <shadows>false</shadows>
    </scene>
    <light name="sun" type="directional">
      <pose>0 0 500 0 0 0</pose>
      <direction>0.001 0.625 -0.78</direction>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <cast_shadows>false</cast_shadows>
    </light>
    <model name="ground">
      <static>true</static>
      <link name="ground">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>
    <include><uri>file:///etc/mission-sim/survey-ground.sdf</uri></include>
    <model name="inspection_stop_sign">
      <static>true</static>
      <pose degrees="true">12.5 22.8 0.015 0 0 -75</pose>
      <link name="sign">
        <visual name="face">
          <geometry><mesh><uri>file:///etc/mission-sim/stop-sign.obj</uri></mesh></geometry>
          <material>
            <ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse>
            <pbr><metal>
              <albedo_map>/etc/mission-sim/stop-sign.png</albedo_map>
              <metalness>0</metalness><roughness>1</roughness>
            </metal></pbr>
          </material>
        </visual>
      </link>
    </model>
    <!-- Workshop's final NED waypoint (-4, 8) is Gazebo ENU (8, -4). -->
    <include>
      <uri>model://arucotag</uri>
      <name>landing_target</name>
      <pose>8 -4 0.001 0 0 0</pose>
    </include>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>37.412173071650805</latitude_deg>
      <longitude_deg>-121.998878727967</longitude_deg>
      <elevation>38</elevation>
    </spherical_coordinates>
  </world>
</sdf>
